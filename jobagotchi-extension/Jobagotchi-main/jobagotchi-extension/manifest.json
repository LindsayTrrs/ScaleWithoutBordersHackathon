{
  "manifest_version": 3,
  "name": "Jobagotchi",
  "version": "1.0",
  "description": "AI Job Validator",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://*.linkedin.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}